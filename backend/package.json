{
  "name": "tontine-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST sécurisée pour la gestion de tontines",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@emailjs/nodejs": "^5.0.2",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.15.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "resend": "^6.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  }
}
